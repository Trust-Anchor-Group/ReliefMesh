# Copy to .env locally. Never commit the real .env or send keys in chat.
RELIEFMESH_HOST=127.0.0.1
RELIEFMESH_PORT=4317
RELIEFMESH_PUBLIC_ORIGIN=http://localhost:4317
RELIEFMESH_RUNTIME_DIR=.runtime
RELIEFMESH_TRUST_PROXY=0
PUBLIC_SANDBOX=1
SANDBOX_COOKIE_SECURE=0

# Replace these paths on the deployment host. Keep both data stores private and persistent.
NEUROALI_DLL=C:\Users\alile\NeuroAli\bin\Release\net8.0\NeuroAli.dll
NEUROALI_DATA_A=C:\Users\alile\NeuroAli\.neuroali-data
NEUROALI_DATA_B=C:\Users\alile\NeuroAli\.neuroali-data-b
NEUROALI_PORT_A=52482
NEUROALI_PORT_B=52483

# The parser enforces a maximum of 0.03 TST regardless of prompt instructions.
DEMO_PAYMENT_AMOUNT=0.01

AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
# For another tool-capable provider:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=

